rules_version = '2';
// Paste into Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.get('email', '') : ''; }
    function isManager() { return email() == 'd1672@makarm-sales.app'; }
    function isViewer() { return email() == 'v12345@makarm-sales.app'; }
    function sellerProfile() { return get(/databases/$(database)/documents/sellers/$(request.auth.uid)); }
    function myCode() { return sellerProfile().data.code; }
    // An activated seller whose employee entry is still switched on
    function isSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(myCode())).data.active == true;
    }

    // Public lookup used by the login screen: only "does this code exist" + login counter
    match /logins/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isManager();
    }

    // Employee list with activation codes: manager only (a seller may read their own entry)
    match /employees/{code} {
      allow read: if isManager() || (isSeller() && myCode() == code);
      allow write: if isManager();
    }

    // One claim per employee code; created together with the seller profile
    match /claims/{code} {
      allow read: if isManager();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.code == code;
      allow delete: if isManager();
    }

    // Links a Firebase account to an employee code; needs the manager's activation code
    match /sellers/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'activation', 'at'])
        && get(/databases/$(database)/documents/employees/$(request.resource.data.code)).data.active == true
        && get(/databases/$(database)/documents/employees/$(request.resource.data.code)).data.activation == request.resource.data.activation
        && !exists(/databases/$(database)/documents/claims/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/claims/$(request.resource.data.code)).data.uid == uid;
      allow delete: if isManager();
    }

    match /orders/{id} {
      allow read: if isManager() || isViewer()
        || (isSeller() && resource.data.sellerCode == myCode());
      allow create: if isSeller() && request.resource.data.sellerCode == myCode();
      allow update: if isManager()
        || (isSeller() && resource.data.sellerCode == myCode()
            && request.resource.data.sellerCode == myCode());
      allow delete: if false;
    }
  }
}
