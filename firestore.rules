rules_version = '2';
// Paste into Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.get('email', '') : ''; }
    function isManager() { return email() == 'd1672@makarm-sales.app'; }
    // Legacy read-only account (before roles existed)
    function isLegacyViewer() { return email() == 'v12345@makarm-sales.app'; }
    function sellerProfile() { return get(/databases/$(database)/documents/sellers/$(request.auth.uid)); }
    function myCode() { return sellerProfile().data.code; }
    function myEmployee() { return get(/databases/$(database)/documents/employees/$(myCode())); }
    // An activated employee whose entry is still switched on
    function isLinked() {
      return signedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && myEmployee().data.active == true;
    }
    function myRole() { return myEmployee().data.get('role', 'seller'); }
    function isSeller() { return isLinked() && myRole() == 'seller'; }
    function isViewer() { return isLegacyViewer() || (isLinked() && myRole() == 'viewer'); }
    function isSupervisor() { return isLinked() && myRole() == 'supervisor'; }
    function isInstaller() { return isLinked() && myRole() == 'installer'; }

    // Public lookup used by the login screen: only "does this code exist" + login counter
    match /logins/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isManager();
    }

    // Employee list: manager only (an employee may read their own entry)
    match /employees/{code} {
      allow read: if isManager() || (isLinked() && myCode() == code);
      allow write: if isManager();
    }

    // One claim per employee code; created together with the seller profile
    match /claims/{code} {
      allow read: if isManager();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.code == code;
      allow delete: if isManager();
    }

    // Links a Firebase account to an employee code (first come, first served; manager can reset)
    match /sellers/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && get(/databases/$(database)/documents/employees/$(request.resource.data.code)).data.active == true
        && !exists(/databases/$(database)/documents/claims/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/claims/$(request.resource.data.code)).data.uid == uid;
      allow delete: if isManager();
    }

    match /orders/{id} {
      allow read: if isManager() || isViewer() || isSupervisor()
        || (isInstaller() && resource.data.withInstall == true)
        || (isSeller() && resource.data.sellerCode == myCode());
      allow create: if isSeller() && request.resource.data.sellerCode == myCode();
      allow update: if isManager() || isSupervisor()
        // installer: installation invoices only, and only replies + "installation done"
        || (isInstaller() && resource.data.withInstall == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'installDone']))
        || (isSeller() && resource.data.sellerCode == myCode()
            && request.resource.data.sellerCode == myCode());
      allow delete: if false;
    }

    // Files attached to replies (one per document; never edited or deleted)
    match /attachments/{id} {
      allow read: if isManager() || isViewer() || isSupervisor()
        || (isInstaller() && resource.data.install == true)
        || (isSeller() && resource.data.sellerCode == myCode());
      allow create: if (isManager() || isSupervisor()
          || (isInstaller() && request.resource.data.install == true && request.resource.data.from == 'installer'))
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update, delete: if false;
    }
  }
}
